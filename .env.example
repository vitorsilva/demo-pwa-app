# Saberloop Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# API Configuration
# =============================================================================

# Anthropic API Key (for server-side Netlify Functions)
# Get your key from: https://console.anthropic.com/
# Only needed if using Netlify Functions backend
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# Development Options
# =============================================================================

# Use real API vs mock API
# - false: Use mock API (default, no API costs, instant responses)
# - true: Use real API via OpenRouter (requires user to connect their key)
VITE_USE_REAL_API=false

# =============================================================================
# Telemetry (Phase 40)
# =============================================================================

# Enable/disable telemetry sending (also controlled by feature flag)
VITE_TELEMETRY_ENABLED=false

# VPS endpoint URL for telemetry ingestion
VITE_TELEMETRY_ENDPOINT=https://saberloop.com/telemetry/ingest.php

# Auth token for telemetry endpoint (set a secure random string)
VITE_TELEMETRY_TOKEN=your-secure-token-here

# Batch size - send when this many events are queued (default: 10)
VITE_TELEMETRY_BATCH_SIZE=10

# Flush interval in ms - send at least this often (default: 30000 = 30s)
VITE_TELEMETRY_FLUSH_INTERVAL=30000

# =============================================================================
# Integration Testing API Keys (Epic 11)
# =============================================================================

# These keys are REQUIRED for running integration tests that verify
# real LLM provider integrations. Without them, integration tests are skipped.
# Get keys from each provider's console/dashboard.

# OpenAI: https://platform.openai.com/api-keys
TEST_OPENAI_KEY=sk-your-openai-key

# Anthropic: https://console.anthropic.com/settings/keys
TEST_ANTHROPIC_KEY=sk-ant-your-anthropic-key

# Google AI: https://aistudio.google.com/apikey
TEST_GOOGLE_KEY=AIza-your-google-key

# xAI: https://console.x.ai
TEST_XAI_KEY=xai-your-xai-key

# OpenRouter (for existing tests): https://openrouter.ai/keys
TEST_OPENROUTER_KEY=sk-or-v1-your-openrouter-key

# =============================================================================
# FTP Deployment (Optional)
# =============================================================================

# Only needed if deploying to a VPS via FTP
FTP_HOST=your-ftp-host
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password

# =============================================================================
# Notes
# =============================================================================
#
# - Variables starting with VITE_ are exposed to the frontend
# - Variables without VITE_ prefix are only available server-side
# - Never commit your .env file (it's in .gitignore)
# - For production, set environment variables in Netlify Dashboard
