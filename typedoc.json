{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "exclude": ["**/*.test.js", "**/*.d.ts"],
  "excludeExternals": true,
  "excludePrivate": true,
  "includeVersion": true,
  "readme": "README.md",
  "name": "Saberloop API Documentation",
  "navigationLinks": {
    "GitHub": "https://github.com/vitorsilva/saberloop"
  },
  "tsconfig": "jsconfig.json"
}
