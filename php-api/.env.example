# =============================================================================
# LLM Provider API Keys (Epic 11 - Multi-Provider Support)
# =============================================================================

# Anthropic API Key (existing, for backward compatibility)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# Integration Testing API Keys
# =============================================================================

# These keys are used for local PHP integration testing.
# The backend proxy receives user keys at runtime (not from env),
# but these are useful for direct testing of provider classes.

# OpenAI: https://platform.openai.com/api-keys
TEST_OPENAI_KEY=sk-your-openai-key

# Anthropic: https://console.anthropic.com/settings/keys
TEST_ANTHROPIC_KEY=sk-ant-your-anthropic-key

# Google AI: https://aistudio.google.com/apikey
TEST_GOOGLE_KEY=AIza-your-google-key

# xAI: https://console.x.ai
TEST_XAI_KEY=xai-your-xai-key

# =============================================================================
# Environment
# =============================================================================

# Environment (production or development)
APP_ENV=production