{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/core/db.js",
    "src/core/features.js",
    "src/core/i18n.js",
    "src/core/settings.js",
    "src/core/state.js"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 10000,
  "concurrency": 4,
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-core.html"
  }
}
