{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/utils/adManager.js",
    "src/utils/errorHandler.js",
    "src/utils/formatters.js",
    "src/utils/gradeProgression.js",
    "src/utils/json-extractor.js",
    "src/utils/logger.js",
    "src/utils/network.js",
    "src/utils/retry.js",
    "src/utils/share.js",
    "src/utils/share-image.js",
    "src/utils/shuffle.js",
    "src/utils/storage.js",
    "src/utils/telemetry.js"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 10000,
  "concurrency": 4,
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-utils.html"
  }
}
